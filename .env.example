# Valores locales solamente. scripts/local-env.sh genera secretos distintos por máquina.
POSTGRES_PASSWORD=REEMPLAZAR_CON_UN_SECRETO_LOCAL
GARAGE_DEFAULT_ACCESS_KEY=REEMPLAZAR_CON_UN_ID_LOCAL
GARAGE_DEFAULT_SECRET_KEY=REEMPLAZAR_CON_UN_SECRETO_LOCAL
GARAGE_RPC_SECRET=REEMPLAZAR_CON_64_CARACTERES_HEXADECIMALES
GARAGE_ADMIN_TOKEN=REEMPLAZAR_CON_UN_SECRETO_LOCAL
GARAGE_METRICS_TOKEN=REEMPLAZAR_CON_UN_SECRETO_LOCAL
POSTGRES_HOST_PORT=55432
GARAGE_S3_HOST_PORT=3900
APP_HOST_PORT=5080

# Opcionales. Sin ambos valores, el inicio con Google responde 503.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Configuración solo para pruebas. Usá una base PostgreSQL desechable distinta para Playwright.
ENIGMABUDGET_TEST_CONNECTION=
ENIGMABUDGET_E2E_CONNECTION=
